rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules)
//
// Design: the browser (anon or signed-in) is only ever allowed to READ.
// ALL writes happen server-side through Next.js API routes using the
// Firebase Admin SDK, which bypasses these rules entirely — that's the
// only way data gets created or changed. This keeps owner phone numbers
// and exact addresses out of reach even from a signed-in user's client,
// since those live in a separate `private` subcollection that these
// rules never grant client read access to.

service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile — a user may read their own doc, and update only
    // non-privileged fields. `role` must never be client-writable (that would
    // let anyone self-promote to admin); it is only ever set server-side.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow create: if false; // created server-side on first sign-in
    }

    // A scout may read their own scout record (trust score, earnings).
    match /scouts/{scoutId} {
      allow read: if request.auth != null && request.auth.uid == scoutId;
    }

    // Public safe feed — only verified/community listings, and only the
    // safe fields that were written into this doc at creation time
    // (owner phone / exact address are never stored here — see the
    // `private` subcollection below).
    match /rentalOpportunities/{id} {
      allow read: if resource.data.status == 'verified' || resource.data.status == 'community';

      // The private contact/location subdoc is NEVER client-readable.
      match /private/{document=**} {
        allow read: if false;
      }
    }

    // A seeker may read their own unlock transactions.
    match /unlockTransactions/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.seekerId;
    }

    // A tenant may read their own shortlist entries (writes are server-side).
    match /shortlists/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // A scout may read their own withdrawal requests (writes are server-side).
    match /withdrawals/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.scoutId;
    }

    // A user may read their own saved searches (writes are server-side).
    match /savedSearches/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // A user may read their own entitlement (unlock credits / pass). The doc id
    // is the uid; writes are server-side only (through /api/purchase, /api/unlock).
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // A user may read their own package purchase history (writes are server-side).
    match /packagePurchases/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Scout requests: the renter who created it, or the scout it's assigned to,
    // may read it. All writes go through server-side API routes.
    match /scoutRequests/{id} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.seekerId || request.auth.uid == resource.data.assignedScoutId);
    }

    // In-app notifications: a user may read their own (writes are server-side).
    match /notifications/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Everything else (properties, evidence, verifications, scoutRewards,
    // reports) is server-only.
    match /properties/{id} { allow read: if false; }
    match /evidence/{id} { allow read: if false; }
    match /verifications/{id} { allow read: if false; }
    match /scoutRewards/{id} { allow read: if false; }
    match /reports/{id} { allow read: if false; }
  }
}
